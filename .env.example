DATABASE_URL=postgresql+asyncpg://consensus:consensus@localhost:5432/consensus
REDIS_URL=redis://localhost:6379

# LLM for stance extraction. STANCE_PROVIDER=anthropic|keyword (keyword = offline, deterministic, demo/tests)
ANTHROPIC_API_KEY=
STANCE_PROVIDER=anthropic
STANCE_MODEL=claude-opus-5

# Embeddings. EMBEDDING_PROVIDER=openai|hashing (hashing = offline, deterministic, demo/tests)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
NOTION_TOKEN=
NOTION_TASKS_DB_ID=
ENABLE_GITHUB=true
ENABLE_NOTION=true

CONCEPT_SIMILARITY_THRESHOLD=0.82
DEDUP_SIMILARITY_THRESHOLD=0.92
AXIS_MATCH_OVERLAP=0.67

# Optional: project the MCP tools operate on when the agent does not pass project_id.
DEFAULT_PROJECT_ID=

# Comma-separated origins allowed to call the REST/WS API (frontend dev servers).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- auth ---
SECRET_KEY=change-me
FRONTEND_URL=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Local development only: enables POST /api/auth/dev-login and returns magic links in responses.
DEV_AUTH=true
MCP_AUTH_REQUIRED=true
# Local only: session JWT used by scripts/github_e2e.py (copy from /auth/callback after GitHub sign-in)
DEV_SESSION_TOKEN=

# --- email (magic links, invites). Leave SMTP_HOST empty to log links instead of sending. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Consensus <no-reply@example.com>
SMTP_STARTTLS=true

# Encryption at rest for stored GitHub / Notion tokens. A Fernet key; comma-separate to rotate.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty = derived from SECRET_KEY.
TOKEN_ENCRYPTION_KEY=

# Seconds between background passes of sync_open_prs over live projects. 0 disables.
PR_SYNC_INTERVAL_SECONDS=300
