{
  "description": "Consensus guardrail: no code edits until the plan has been declared and the verdict allows it.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/require_declaration.py\" pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__consensus__declare_intent|mcp__consensus__check_verdict|mcp__consensus__withdraw_claim|mcp__consensus__file_handoff",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/require_declaration.py\" post",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
